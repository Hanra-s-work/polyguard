{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"asperheader.enableDebug": false,
		"asperheader.extensionIgnore": [
			"*.code-workspace",
			"python.version",
			"settings.json",
			"*.txt"
		],
		"asperheader.extensionName": "polyguard",
		"asperheader.promptToCreateIfMissing": true,
		"asperheader.useWorkspaceNameWhenAvailable": true,
		"asperheader.projectCopyright": "(c) Henry Letellier",
		"asperheader.headerLogo": [
			"      input",
			"",
			"   @#$%!  hello",
			"     |     |",
			"     +--+--+",
			"        |",
			"        v",
			"  +------------+",
			"  | POLY GUARD |",
			"  +------------+",
			"    |        |",
			"    v        v",
			" BLOCKED  PASSED",
			"   KO       OK"
		],
		"asperheader.projectDescription": "A module that provides a set of swearwords to listen to when filtering while allowing to toggle on and off different languages.",
		"files.associations": {
			"*.cnf": "nginx" // This is for linting purposes, the comments in both file types are the same.
		}
	},
	"extensions": {
		"recommendations": [
			"ms-python.autopep8",
			"codezombiech.gitignore",
			"ms-python.isort",
			"visualstudioexptteam.vscodeintellicode",
			"giyyapan.pyformat",
			"christian-kohler.path-intellisense",
			"ms-python.vscode-pylance",
			"ms-python.pylint",
			"ms-python.python",
			"foxundermoon.shell-format"
		]
	}
}
